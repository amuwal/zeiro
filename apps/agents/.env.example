ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
DATABASE_URL=postgres://zeiro:zeiro@localhost:6432/zeiro_dev
PORT=6002

# Must be the SAME 64-hex value as the web app's ENCRYPTION_KEY: it is the HMAC
# secret used to verify the signed x-zeiro-firm-token on /api/inquiries/* so the
# agents service derives firmId from a trusted claim, never the request body.
ENCRYPTION_KEY=

# Sentry (optional)
SENTRY_DSN=

# Langfuse Cloud (optional in dev — leave blank to disable LLM tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
