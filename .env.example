# LLM
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENAI_API_KEY=
# Cohere — rerank-v3.5 (optional; without it retrieval falls back to vector + BM25 RRF only)
COHERE_API_KEY=

# Database (local: docker compose up -d postgres → 6432; prod: Neon)
DATABASE_URL=postgres://zeiro:zeiro@localhost:6432/zeiro_dev

# Clerk (https://dashboard.clerk.com → API Keys; enable Organizations + Google OAuth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk → Webhooks → add endpoint pointing at /api/webhooks/clerk → copy signing secret
CLERK_WEBHOOK_SECRET=

# SendGrid (https://app.sendgrid.com)
# - Inbound Parse: enable "POST raw, full MIME message" + Basic Auth on the URL
# - Mail API key (Restricted: Mail Send only) for outbound replies
# - Event Webhook: enable signature verification, copy the ECDSA public key
SENDGRID_INBOUND_WEBHOOK_SECRET=
SENDGRID_API_KEY=
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
OUTBOUND_FROM_DOMAIN=reply.zeiro.jp

# Service URLs
APP_BASE_URL=http://localhost:6001
AGENTS_BASE_URL=http://localhost:6002

# Inngest (production only — for local dev, run `npx inngest-cli@latest dev`)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry (https://sentry.io → create project → copy DSN). Optional — leave blank to disable.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Langfuse Cloud (https://cloud.langfuse.com → create project → API Keys). Optional in dev.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
