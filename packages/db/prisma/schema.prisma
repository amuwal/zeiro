generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [citext, pgcrypto, vector]
}

model Firm {
  id             String   @id @default(uuid()) @db.Uuid
  name           String
  inboundAddress String   @unique @map("inbound_address") @db.Citext
  clerkOrgId     String?  @unique @map("clerk_org_id")
  region         String
  settings       Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  clients         Client[]
  inquiries       Inquiry[]
  drafts          Draft[]
  audits          AuditEvent[]
  knowledge       KnowledgeChunk[]
  memberships     Membership[]
  channels        FirmChannel[]
  globalDisabled  FirmGlobalDisabled[]
  ingestionJobs   KnowledgeIngestionJob[]
  clientImports   ClientImport[]
  integrations    Integration[]
  clientAssignees ClientAssignee[]

  @@map("firms")
}

// Tracks a CSV/XLSX of clients from upload → AI parse → preview → bulk insert.
// Two-phase: a worker reads the bytes and produces a structured `parsed`
// preview the user reviews and confirms; only on confirm do we materialise
// rows in `clients`. Bytes get cleared on transition out of `parsing`.
model ClientImport {
  id            String    @id @default(uuid()) @db.Uuid
  firmId        String    @map("firm_id") @db.Uuid
  actorId       String    @map("actor_id") @db.Uuid
  filename      String
  mimetype      String?
  bytes         Bytes?
  status        String    @default("pending")
  rawRowCount   Int?      @map("raw_row_count")
  parsed        Json?
  importedCount Int?      @map("imported_count")
  skippedCount  Int?      @map("skipped_count")
  errorCode     String?   @map("error_code")
  errorMessage  String?   @map("error_message")
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  startedAt     DateTime? @map("started_at") @db.Timestamptz()
  parsedAt      DateTime? @map("parsed_at") @db.Timestamptz()
  completedAt   DateTime? @map("completed_at") @db.Timestamptz()

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt(sort: Desc)])
  @@index([status])
  @@map("client_imports")
}

// Tracks each user-initiated knowledge upload from request to completion.
// The raw bytes are stored on the row itself (bytea) so the Inngest worker
// can be triggered from any process; once the worker finishes successfully it
// clears `bytes` to keep the table small. Status row stays for audit history.
model KnowledgeIngestionJob {
  id           String    @id @default(uuid()) @db.Uuid
  firmId       String    @map("firm_id") @db.Uuid
  actorId      String    @map("actor_id") @db.Uuid
  source       String
  filename     String
  mimetype     String?
  bytes        Bytes?
  status       String    @default("pending")
  chunkCount   Int?      @map("chunk_count")
  errorCode    String?   @map("error_code")
  errorMessage String?   @map("error_message")
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  startedAt    DateTime? @map("started_at") @db.Timestamptz()
  completedAt  DateTime? @map("completed_at") @db.Timestamptz()

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId, createdAt(sort: Desc)])
  @@index([status])
  @@map("knowledge_ingestion_jobs")
}

model FirmGlobalDisabled {
  firmId     String   @map("firm_id") @db.Uuid
  source     String
  disabledBy String   @map("disabled_by") @db.Uuid
  disabledAt DateTime @default(now()) @map("disabled_at") @db.Timestamptz()

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@id([firmId, source])
  @@index([firmId])
  @@map("firm_global_disabled")
}

model FirmChannel {
  id          String   @id @default(uuid()) @db.Uuid
  firmId      String   @map("firm_id") @db.Uuid
  channelType String   @map("channel_type")
  config      Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  firm Firm @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@unique([firmId, channelType])
  @@map("firm_channels")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  clerkUserId String   @unique @map("clerk_user_id")
  email       String   @db.Citext
  name        String
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  memberships       Membership[]     @relation("MembershipUser")
  supervises        Membership[]     @relation("MembershipSupervisor")
  assignedClients   Client[]         @relation("ClientAssignment")
  assignedInquiries Inquiry[]        @relation("InquiryAssignment")
  clientAssignments ClientAssignee[]

  @@map("users")
}

model Membership {
  userId       String   @map("user_id") @db.Uuid
  firmId       String   @map("firm_id") @db.Uuid
  role         String
  tier         String   @default("member")
  appRole      String   @default("staff") @map("app_role")
  canSend      Boolean  @default(false) @map("can_send")
  clientScope  String   @default("assigned") @map("client_scope")
  supervisorId String?  @map("supervisor_id") @db.Uuid
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz()

  user       User  @relation("MembershipUser", fields: [userId], references: [id], onDelete: Cascade)
  firm       Firm  @relation(fields: [firmId], references: [id], onDelete: Cascade)
  supervisor User? @relation("MembershipSupervisor", fields: [supervisorId], references: [id], onDelete: SetNull)

  @@id([userId, firmId])
  @@index([firmId])
  @@index([supervisorId])
  @@index([firmId, tier])
  @@index([firmId, appRole])
  @@map("memberships")
}

model Client {
  id                      String  @id @default(uuid()) @db.Uuid
  firmId                  String  @map("firm_id") @db.Uuid
  name                    String
  primaryEmail            String  @map("primary_email") @db.Citext
  lineUserId              String? @map("line_user_id")
  chatworkRoomId          String? @map("chatwork_room_id")
  contractType            String  @map("contract_type")
  assignedTaxAccountantId String? @map("assigned_tax_accountant_id") @db.Uuid
  notes                   String?
  metadata                Json    @default("{}")

  firm         Firm      @relation(fields: [firmId], references: [id], onDelete: Cascade)
  inquiries    Inquiry[]
  assignedUser User?     @relation("ClientAssignment", fields: [assignedTaxAccountantId], references: [id])
  integrationBindings ClientIntegrationBinding[]
  assignees    ClientAssignee[]

  @@unique([firmId, primaryEmail])
  @@unique([firmId, lineUserId])
  @@unique([firmId, chatworkRoomId])
  @@map("clients")
}

model Inquiry {
  id              String   @id @default(uuid()) @db.Uuid
  firmId          String   @map("firm_id") @db.Uuid
  clientId        String?  @map("client_id") @db.Uuid
  assignedToId    String?  @map("assigned_to_id") @db.Uuid
  parentInquiryId String?  @map("parent_inquiry_id") @db.Uuid
  messageId       String   @map("message_id")
  receivedAt      DateTime @map("received_at") @db.Timestamptz()
  subject         String
  body            String
  status          String   @default("pending")
  channel         String   @default("email")
  unmatchedSender String?  @map("unmatched_sender")
  analysis        Json     @default("{}")
  headers         Json     @default("{}")

  firm           Firm         @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id])
  assignedTo     User?        @relation("InquiryAssignment", fields: [assignedToId], references: [id])
  parentInquiry  Inquiry?     @relation("InquiryThread", fields: [parentInquiryId], references: [id])
  childInquiries Inquiry[]    @relation("InquiryThread")
  drafts         Draft[]
  audits         AuditEvent[]

  @@unique([firmId, messageId])
  @@index([firmId, receivedAt(sort: Desc)])
  @@index([firmId, assignedToId])
  @@index([firmId, channel])
  @@index([parentInquiryId])
  @@map("inquiries")
}

model Draft {
  id         String   @id @default(uuid()) @db.Uuid
  inquiryId  String   @map("inquiry_id") @db.Uuid
  firmId     String   @map("firm_id") @db.Uuid
  subject    String
  body       String
  citations  Json     @default("[]")
  confidence Float
  model      String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  firm    Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt(sort: Desc)])
  @@index([firmId])
  @@map("drafts")
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  firmId    String   @map("firm_id") @db.Uuid
  actorId   String   @map("actor_id") @db.Uuid
  inquiryId String?  @map("inquiry_id") @db.Uuid
  action    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  firm    Firm     @relation(fields: [firmId], references: [id])
  inquiry Inquiry? @relation(fields: [inquiryId], references: [id])

  @@index([firmId, createdAt(sort: Desc)])
  @@map("audit_events")
}

// Per-user "seen" state for inquiries (WhatsApp/email-style read tracking).
// No Prisma relations — integrity is enforced by DB-level FKs in the migration;
// the model only needs scalar fields for upsert/lookup.
model InquiryRead {
  id        String   @id @default(uuid()) @db.Uuid
  firmId    String   @map("firm_id") @db.Uuid
  inquiryId String   @map("inquiry_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz()

  @@unique([inquiryId, userId])
  @@index([firmId, userId])
  @@map("inquiry_reads")
}

model KnowledgeChunk {
  id        String                      @id @default(uuid()) @db.Uuid
  firmId    String?                     @map("firm_id") @db.Uuid
  scope     String                      @default("firm")
  source    String
  content   String
  embedding Unsupported("vector(1536)")
  metadata  Json                        @default("{}")

  firm Firm? @relation(fields: [firmId], references: [id], onDelete: Cascade)

  @@index([firmId])
  @@index([scope])
  @@map("knowledge_chunks")
}

model Integration {
  id              String    @id @default(uuid()) @db.Uuid
  firmId          String    @map("firm_id") @db.Uuid
  provider        String
  accessToken     String    @map("access_token")
  refreshToken    String?   @map("refresh_token")
  tokenType       String    @default("Bearer") @map("token_type")
  scope           String?
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz()
  status          String    @default("active")
  lastRefreshedAt DateTime? @map("last_refreshed_at") @db.Timestamptz()
  lastError       String?   @map("last_error")
  metadata        Json      @default("{}")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  firm     Firm                       @relation(fields: [firmId], references: [id], onDelete: Cascade)
  bindings ClientIntegrationBinding[]

  @@unique([firmId, provider])
  @@index([status, expiresAt])
  @@map("integrations")
}

// Per-client 担当者 assignment. Drives "assigned-only" client scoping for
// Staff/Viewer (§54 need-to-know). `role` distinguishes primary 担当 from
// secondary helpers and the supervising reviewer. The denormalized
// clients.assigned_tax_accountant_id remains the single "primary" pointer.
model ClientAssignee {
  id        String   @id @default(uuid()) @db.Uuid
  firmId    String   @map("firm_id") @db.Uuid
  clientId  String   @map("client_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  firm   Firm   @relation(fields: [firmId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clientId, userId])
  @@index([firmId])
  @@index([userId])
  @@index([firmId, userId])
  @@map("client_assignees")
}

model ClientIntegrationBinding {
  id            String   @id @default(uuid()) @db.Uuid
  integrationId String   @map("integration_id") @db.Uuid
  clientId      String   @map("client_id") @db.Uuid
  externalId    String   @map("external_id")
  externalName  String?  @map("external_name")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  client      Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, integrationId])
  @@index([integrationId])
  @@map("client_integration_bindings")
}
