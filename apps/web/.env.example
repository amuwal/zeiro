DATABASE_URL=postgres://zeiro:zeiro@localhost:6432/zeiro_dev
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_INBOUND_WEBHOOK_SECRET=
RESEND_EVENT_WEBHOOK_SECRET=
OUTBOUND_FROM_DOMAIN=reply.zeiro.jp
AGENTS_BASE_URL=http://localhost:6002

# 64-hex (32 bytes). Load-bearing for tenant isolation: it is the HMAC root for
# the signed x-zeiro-firm-token (web -> agents) and the OAuth `state` blob, plus
# AES-GCM data encryption. MUST be byte-identical to the agents service's
# ENCRYPTION_KEY — a divergent key (rotated on only one platform) makes 100% of
# drafts + chat 401 while everything else keeps working. Rotate both together.
ENCRYPTION_KEY=

# Inngest (leave blank for local dev — uses inngest-cli dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry (optional — leave blank to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
